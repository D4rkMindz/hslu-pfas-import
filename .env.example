# Project Database
# .env is for running on the host (`uv run`, tests); .env.docker overrides host and port for containers.
POSTGRES_HOST=localhost
# Must match KESTRA_POSTGRES_PORT in .env.docker (the port Postgres is published on)
POSTGRES_PORT=5432
POSTGRES_DB=pfas_import
POSTGRES_USER=pfas
POSTGRES_PASSWORD=<your-super-secret-password-here>

KESTRA_PGADMIN_PORT=8086
PGADMIN_DEFAULT_EMAIL=your@email.com
PGADMIN_DEFAULT_PASSWORD=<your-super-secret-password-here>

# S3 storage for TARGET=local: SeaweedFS, published on the host at KESTRA_S3_API_PORT from .env.docker (the port
# below must match it). Containers use the Docker service name instead, see .env.docker.
S3_ENDPOINT_URL=http://localhost:8333
S3_RAW_BUCKET=raw
S3_IMPORT_BUCKET=import
S3_REGION=us-east-1
S3_ACCESS_KEY=pfas
S3_SECRET_KEY=<your-super-secret-key-here>

# use alias for s3fs
FSSPEC_S3_ENDPOINT_URL=$S3_ENDPOINT_URL
FSSPEC_S3_KEY=$S3_ACCESS_KEY
FSSPEC_S3_SECRET=$S3_SECRET_KEY

# Where the Parquet files go with TARGET=local: "auto" (default: S3 if FSSPEC_S3_ENDPOINT_URL or FSSPEC_S3_KEY is
# set, otherwise the local folder LOCAL_DATA_DIR), "s3" or "local" (for development and tests).
#OBJECT_STORE=auto
# LOCAL_DATA_DIR defaults to data/ in the project root; a relative path is relative to the working directory.
#LOCAL_DATA_DIR=/absolute/path/to/data

# Kestra Orchestrator
KESTRA_PORT=8080
KESTRA_POSTGRES_DB=kestra
KESTRA_POSTGRES_USER=kestra
KESTRA_POSTGRES_PASSWORD=<your-super-secret-password-here>

KESTRA_UI_USER=your@email.com
# At least 8 characters with an uppercase letter and a number, otherwise Kestra does not start
KESTRA_UI_PASSWORD=<your-super-secret-password-here>

# Where the pipeline stores the files and publishes the features: "local" (SeaweedFS + the PostgreSQL database
# above) or "cloud" (Google Cloud Storage + BigQuery, provisioned with Terraform by `make setup`, see README "Cloud").
TARGET=local

# --- TARGET=cloud only ---------------------------------------------------------------------------------------------
# GCP project for the buckets and BigQuery. Empty: `make setup` creates a new project and writes its id here.
# Terraform (`make tf-*`) reads it from here, too.
GCP_PROJECT_ID=
# Billing account for the project (`gcloud billing accounts list`). Empty: `make setup` links your only open one.
GCP_BILLING_ACCOUNT=

# BigQuery dataset holding the feature table, and its location (europe-west6 = Zurich), also the location of the
# buckets. Terraform creates them with exactly these values, so keep them in sync by only setting them here.
BIGQUERY_DATASET=pfas_import
BIGQUERY_LOCATION=europe-west6

# HMAC key of the pipeline's service account for the buckets (S3 API). Written by `make setup`.
GCS_HMAC_ACCESS_ID=
GCS_HMAC_SECRET=
