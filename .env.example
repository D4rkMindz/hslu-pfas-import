POSTGRES_DB=pfas_import
POSTGRES_USER=pfas
POSTGRES_PASSWORD=<your-super-secret-password-here>

# S3 storage. Local: SeaweedFS. Prod: leave S3_ENDPOINT_URL empty to use AWS S3.
S3_ENDPOINT_URL=http://localhost:8333
S3_RAW_BUCKET=raw
S3_REGION=us-east-1
S3_ACCESS_KEY=pfas
S3_SECRET_KEY=<your-super-secret-key-here>