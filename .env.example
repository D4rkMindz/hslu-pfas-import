# Project Database
POSTGRES_HOST=localhost
POSTGRES_DB=pfas_import
POSTGRES_USER=pfas
POSTGRES_PASSWORD=<your-super-secret-password-here>

PGADMIN_PORT=8086
PGADMIN_DEFAULT_EMAIL=your@email.com
PGADMIN_DEFAULT_PASSWORD=<your-super-secret-password-here>

# S3 storage. Local: SeaweedFS, reachable via its Docker service name on the
# `development`/`production` networks (NOT localhost - containers can't reach
# each other via localhost). Prod: leave S3_ENDPOINT_URL empty to use AWS S3.
S3_ENDPOINT_URL=http://seaweedfs:8333
S3_RAW_BUCKET=raw
S3_REGION=us-east-1
S3_ACCESS_KEY=pfas
S3_SECRET_KEY=<your-super-secret-key-here>

# use alias for s3fs
FSSPEC_S3_ENDPOINT_URL=$S3_ENDPOINT_URL
FSSPEC_S3_KEY=$S3_ACCESS_KEY
FSSPEC_S3_SECRET=$S3_SECRET_KEY

# Kestra Orchestrator
KESTRA_PORT=8080
KESTRA_POSTGRES_DB=kestra
KESTRA_POSTGRES_USER=kestra
KESTRA_POSTGRES_PASSWORD=<your-super-secret-password-here>

KESTRA_UI_USER=your@email.com
KESTRA_UI_PASSWORD=<your-super-secret-password-here>

KESTRA_DATA_DIR=/app/storage
