# Override docker specific configuration

# Set ports
KESTRA_PORT=8080
KESTRA_POSTGRES_PORT=5432
KESTRA_PGADMIN_PORT=8086
KESTRA_S3_API_PORT=8333
KESTRA_S3_FILER_PORT=8888
KESTRA_S3_MAIN_UI_PORT=9333
KESTRA_S3_ADMIN_UI_PORT=23646

# Project Database

POSTGRES_HOST=postgres
# Container port, not the published KESTRA_POSTGRES_PORT (overrides POSTGRES_PORT from .env)
POSTGRES_PORT=5432

# S3 storage
# Containers reach SeaweedFS on its *container* port (8333), never on the published KESTRA_S3_API_PORT:
# e.g. seaweedfs:18333 is SeaweedFS's gRPC port and answers S3 requests with HTTP/2 garbage.
S3_ENDPOINT_URL=http://seaweedfs:8333

# use alias for s3fs
FSSPEC_S3_ENDPOINT_URL=${S3_ENDPOINT_URL}

# TARGET=cloud, for `docker compose run pfas-import ...`: there is no gcloud login inside the container, so it uses
# the service account key `make setup` writes to secrets/ (mounted as /app/secrets)
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/gcp-service-account.json
