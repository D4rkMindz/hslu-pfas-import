# Override docker specific configuration

# Set ports
KESTRA_PORT=8080
KESTRA_POSTGRES_PORT=5432
KESTRA_PGADMIN_PORT=8086
KESTRA_S3_API_PORT=8333
KESTRA_S3_FILER_PORT=8888
KESTRA_S3_MAIN_UI_PORT=9333
KESTRA_S3_ADMIN_UI_PORT=23646

# Project Database

POSTGRES_HOST=postgres

# S3 storage
S3_ENDPOINT_URL=http://seaweedfs:${KESTRA_S3_API_PORT}

# use alias for s3fs
FSSPEC_S3_ENDPOINT_URL=${S3_ENDPOINT_URL}